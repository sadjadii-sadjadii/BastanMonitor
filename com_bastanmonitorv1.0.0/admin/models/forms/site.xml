<form>
    <fieldset name="details">
        <field name="id" type="hidden" />
        
        <field name="title" type="text" label="COM_BASTANMONITOR_FIELD_SITE_TITLE_LABEL" required="true" class="form-control" />
        
        <field name="domain" type="text" label="COM_BASTANMONITOR_FIELD_DOMAIN_LABEL" description="COM_BASTANMONITOR_FIELD_DOMAIN_DESC" required="true" class="form-control" />
        
        <field name="is_offline" type="radio" label="COM_BASTANMONITOR_FIELD_IS_OFFLINE_LABEL" default="0" class="btn-group btn-group-yesno">
            <option value="0">COM_BASTANMONITOR_OPTION_LIVE_SITE</option>
            <option value="1">COM_BASTANMONITOR_OPTION_OFFLINE_SITE</option>
        </field>

        <field name="url" type="url" label="COM_BASTANMONITOR_FIELD_AGENT_URL_LABEL" description="COM_BASTANMONITOR_FIELD_AGENT_URL_DESC" class="form-control" showon="is_offline:0" />
        <field
            name="agent_token"
            type="text"
            label="COM_BASTANMONITOR_FIELD_AGENT_TOKEN_LABEL"
            description="COM_BASTANMONITOR_FIELD_AGENT_TOKEN_DESC"
            class="form-control"
            size="40"
        />
        <field name="state" type="list" label="COM_BASTANMONITOR_FIELD_STATE_LABEL" default="1" class="form-select">
            <option value="1">COM_BASTANMONITOR_OPTION_ACTIVE</option>
            <option value="0">COM_BASTANMONITOR_OPTION_INACTIVE</option>
        </field>
    </fieldset>
</form>