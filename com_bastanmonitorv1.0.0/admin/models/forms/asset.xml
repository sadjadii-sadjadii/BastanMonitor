<form>
    <fieldset name="details">
        <field name="id" type="hidden" />
        
        <field name="site_id" type="sql" label="COM_BASTANMONITOR_FIELD_SITE_ID_LABEL" 
               query="SELECT id, title FROM #__bastanmonitor_sites WHERE state = 1 ORDER BY title ASC" 
               key_field="id" 
               value_field="title" 
               required="true" class="form-select" />
               
        <field name="type" type="list" label="COM_BASTANMONITOR_FIELD_TYPE_LABEL" required="true" class="form-select" translate="true">
            <option value="domain">COM_BASTANMONITOR_TYPE_DOMAIN</option>
            <option value="host">COM_BASTANMONITOR_TYPE_HOST</option>
            <option value="server">COM_BASTANMONITOR_TYPE_SERVER</option>
            <option value="ssl">COM_BASTANMONITOR_TYPE_SSL</option>
            <option value="enamad">COM_BASTANMONITOR_TYPE_ENAMAD</option>
            <option value="subscription">COM_BASTANMONITOR_TYPE_SUBSCRIPTION</option>
            <option value="other">COM_BASTANMONITOR_TYPE_OTHER</option>
        </field>

        <field name="host_company" type="text" label="COM_BASTANMONITOR_FIELD_HOST_COMPANY_LABEL" description="COM_BASTANMONITOR_FIELD_HOST_COMPANY_DESC" class="form-control" />
        
        <field name="expiration_date" type="calendar" label="COM_BASTANMONITOR_FIELD_EXPIRATION_DATE_LABEL" format="%Y-%m-%d %H:%M:%S" required="true" class="form-control" />
    </fieldset>
</form>