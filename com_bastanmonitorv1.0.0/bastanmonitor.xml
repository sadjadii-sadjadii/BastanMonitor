<extension type="component" version="4.0" method="upgrade">
    <name>Bastan Monitor</name>
    <creationDate>July 2026</creationDate>
    <author>BastanGraphic</author>
    <authorEmail>sadjadii@gmail.com</authorEmail>
    <authorUrl>https://bastangraphic.com</authorUrl>
    <copyright>Copyright (C) 2026 Bastan Graphic</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>1.0.0</version>
    <description>COM_BASTANMONITOR_XML_DESCRIPTION</description>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>

    <administration>
        <menu img="class:chart-pie">COM_BASTANMONITOR_MENU</menu>
        <submenu>
            <menu link="option=com_bastanmonitor&amp;view=dashboard">COM_BASTANMONITOR_MENU_DASHBOARD</menu>
            <menu link="option=com_bastanmonitor&amp;view=sites">COM_BASTANMONITOR_MENU_SITES</menu>
            <menu link="option=com_bastanmonitor&amp;view=assets">COM_BASTANMONITOR_MENU_ASSETS</menu>
            <menu link="option=com_bastanmonitor&amp;view=alerts">COM_BASTANMONITOR_MENU_ALERTS</menu>
            <menu link="option=com_bastanmonitor&amp;view=glance">COM_BASTANMONITOR_MENU_GLANCE</menu>
        </submenu>
        <files folder="admin">
            <folder>sql</folder>
            <folder>language</folder>
            <folder>controllers</folder> 
            <folder>models</folder> 
            <folder>views</folder> 
            <folder>tables</folder>
            <folder>tasks</folder>
            <file>bastanmonitor.php</file>
            <file>controller.php</file> 
        </files>
    </administration>
    
    <tasks>
        <task type="bastanmonitor.sync" name="همگام‌سازی خودکار مانیتورینگ" description="بررسی دوره‌ای سایت‌ها در پس‌زمینه" file="administrator/components/com_bastanmonitor/tasks/sync.php" class="Bastanmonitor\Component\Bastanmonitor\Administrator\Task\SyncTask" />
    </tasks>
    
    <updateservers>
        <server type="extension" priority="1" name="Bastan Monitor Update Server">https://raw.githubusercontent.com/sadjadii-sadjadii/BastanMonitor/main/update.xml</server>
    </updateservers>
</extension>